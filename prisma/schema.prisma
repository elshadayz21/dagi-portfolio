generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NEGOTIATING
  WON
  LOST
}

enum TractorAvailability {
  IN_STOCK
  PRE_ORDER
  OUT_OF_STOCK
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(CONTENT_MANAGER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leadNotes    LeadNote[]
}

model Profile {
  id               String   @id @default(cuid())
  fullName         String   @default("Dagim Melese")
  jobTitle         String   @default("Agricultural Machinery Sales Specialist")
  companyName      String   @default("Tekhaf Trading")
  phone            String   @default("+251 91 123 4567")
  whatsapp         String   @default("+251 91 123 4567")
  email            String   @default("dagim@tekhaf.com")
  address          String   @default("Addis Ababa, Ethiopia")
  experienceYears  Int      @default(12)
  profilePhoto     String   @default("https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=80")
  biography        String   @db.Text
  expertise        String[] @default(["Tractor Selection", "Mechanized Farming Consulting", "After-Sales Support", "Spare Parts Procurement"])
  certifications   String[] @default(["Certified Heavy Agricultural Machinery Consultant", "Advanced Diesel Powertrain Specialist"])
  updatedAt        DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  brand           String              // Massey Ferguson, New Holland, Lovol, John Deere, etc.
  modelNumber     String
  horsepower      Int                 // e.g. 75, 85, 120
  engineType      String              // e.g. 4-Cylinder Turbocharged Diesel
  fuelType        String              @default("Diesel")
  transmission    String              // e.g. 8 Forward + 2 Reverse Mechanical
  driveType       String              @default("4WD") // 2WD or 4WD
  hydraulicLift   String?             // e.g. 2145 kg
  ptoSpeed        String?             // e.g. 540 / 1000 RPM
  price           Decimal?            @db.Decimal(12, 2)
  currency        String              @default("ETB")
  availability    TractorAvailability @default(IN_STOCK)
  isFeatured      Boolean             @default(false)
  summary         String              @db.Text
  description     String              @db.Text
  keyBenefits     String[]
  specifications  Json?               // Full spec key-value dictionary
  categoryId      String?
  category        Category?           @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  leads           Lead[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([brand])
  @@index([horsepower])
  @@index([availability])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Lead {
  id                 String     @id @default(cuid())
  fullName           String
  email              String?
  phone              String
  region             String     // Addis Ababa, Oromia, Sidama, Somali Region, Amhara Region, etc.
  farmSizeHectares   Float?
  interestedProductId String?
  interestedProduct  Product?   @relation(fields: [interestedProductId], references: [id])
  message            String     @db.Text
  status             LeadStatus @default(NEW)
  source             String     @default("Website Form")
  notes              LeadNote[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
  @@index([region])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  farmOrOrg    String?  // e.g. "Arsi Wheat Growers Cooperative"
  region       String   // e.g. "Oromia"
  image        String?
  testimonial  String   @db.Text
  rating       Int      @default(5)
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ServiceArea {
  id               String   @id @default(cuid())
  regionName       String   @unique // Addis Ababa, Oromia, Hawassa / Sidama, Dire Dawa, Somali Region, Amhara Region
  slug             String   @unique
  summary          String   @db.Text
  soilAndCrops     String   @db.Text // Context: "Teff, wheat, barley, clay loam terrain"
  recommendedHPs   String[] // ["75 HP", "85 HP", "110 HP 4WD"]
  regionalOffice   String?
  phone            String?
  isActive         Boolean  @default(true)
}

model Translation {
  id        String   @id @default(cuid())
  locale    String   // en, am, or, so, sid
  namespace String   // common, hero, products, contact, seo
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
}

model MediaLibrary {
  id           String   @id @default(cuid())
  title        String
  url          String
  publicId     String?
  resourceType String   @default("image") // image, pdf, video
  fileSize     Int?
  format       String?
  createdAt    DateTime @default(now())
}

model SEOSetting {
  id             String   @id @default(cuid())
  routePath      String   @unique // "/", "/products", "/about", "/tractors-addis-ababa"
  title          String
  description    String   @db.Text
  keywords       String[]
  ogImageUrl     String?
  canonicalUrl   String?
  structuredType String   @default("WebPage")
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id                 String   @id @default(cuid())
  companyName        String   @default("Tekhaf Trading")
  companySlogan      String   @default("Reliable Agricultural Machinery & Tractor Solutions in Ethiopia")
  salesRepresentative String  @default("Dagim Melese")
  representativeRole String   @default("Tractor Sales Specialist")
  primaryPhone       String   @default("+251 91 123 4567")
  secondaryPhone     String?  @default("+251 11 654 3210")
  whatsappNumber     String   @default("+251 91 123 4567")
  contactEmail       String   @default("dagim@tekhaf.com")
  officeAddress      String   @default("Bole Sub-City, Tekhaf Tower, Addis Ababa, Ethiopia")
  facebookUrl        String?
  telegramUrl        String?  @default("https://t.me/tekhaftractors")
  updatedAt          DateTime @updatedAt
}

model Analytics {
  id        String   @id @default(cuid())
  event     String   // "page_view", "lead_submission", "whatsapp_click", "call_click"
  page      String
  locale    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

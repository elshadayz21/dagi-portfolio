# ==============================================================================
# Tekhaf Tractor Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and update with your environment values:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE URL
# ------------------------------------------------------------------------------
# Public website base URL (used for canonical URLs, sitemaps, robots.txt, metadata)
NEXT_PUBLIC_SITE_URL="https://tekhaftractors.com"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
# Full URL of your Next.js application (http://localhost:3000 in local development)
NEXTAUTH_URL="http://localhost:3000"

# Secret key used to encrypt session tokens and JWTs.
# In production, generate a secure random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET="tekhaf-tractor-platform-super-secret-key-dagim-melese-2026"

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL / PRISMA)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tekhaf_tractors?schema=public"

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATIONS (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key for sending automated tractor quote and lead email notifications
# Obtain a key from: https://resend.com
RESEND_API_KEY=""

# Admin email address where new inquiries and lead alerts are delivered
ADMIN_NOTIFICATION_EMAIL="dagim@tekhaf.com"

# Verified sender email address configured on your Resend sending domain
SENDER_EMAIL="sales@tekhaf.com"

# ------------------------------------------------------------------------------
# 5. MEDIA & CLOUD STORAGE (CLOUDINARY - OPTIONAL)
# ------------------------------------------------------------------------------
# Cloudinary credentials for cloud asset storage (optional; platform also supports local assets)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tekhaf-trading"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 6. ANALYTICS & MONITORING (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
